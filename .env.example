# Optional. Leave empty or unset to run WebMPC without PocketBase sync.
# For Vite development with a local PocketBase process:
# VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Docker Compose defaults to the same-origin /pb proxy. Override it only when
# the frontend should use a separate PocketBase HTTPS host, for example:
# VITE_POCKETBASE_URL=https://pocketbase.example.ts.net
